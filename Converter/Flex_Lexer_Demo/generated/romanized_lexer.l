%%

int main(int argc, char **argv) {
  if (argc != 3 || strcmp(argv[1], "--language") != 0) {
    fprintf(stderr, "Usage: %s --language singlish|tanglish|hinglish < input.txt\\n", argv[0]);
    return EXIT_FAILURE;
  }
  if (strcmp(argv[2], "singlish") == 0) BEGIN(SINGLISH);
  else if (strcmp(argv[2], "tanglish") == 0) BEGIN(TANGLISH);
  else if (strcmp(argv[2], "hinglish") == 0) BEGIN(HINGLISH);
  else { fprintf(stderr, "Unknown language: %s\\n", argv[2]); return EXIT_FAILURE; }
  yylex();
  printf("UNICODE_OUTPUT [%s]\\n", unicode_output ? unicode_output : "");
  free(unicode_output);
  return EXIT_SUCCESS;
}
